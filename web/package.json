{
  "name": "its-maps-web",
  "private": true,
  "version": "1.0.51",
  "productName": "ITS Maps",
  "description": "Aplikasi Windows ITS Maps untuk sinkronisasi Raspberry Pi, website, peta realtime, grafik lalu lintas, kamera, dan auto-update.",
  "author": {
    "name": "Hanifa Septhi Larasati - Telkom University"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run poi:generate && node scripts/generate-method-docs.mjs && tsc && vite build && node scripts/prepare-hosting-artifacts.mjs",
    "cloudflare:check": "npm --prefix cloudflare-worker run check",
    "cloudflare:dev": "npm --prefix cloudflare-worker run dev",
    "cloudflare:deploy": "npm --prefix cloudflare-worker run deploy",
    "poi:generate": "node scripts/generate-poi-icons.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:indexnow:dry": "node scripts/submit-indexnow.mjs --dry-run",
    "test:research": "node scripts/test-research-architecture.mjs",
    "map:data:build": "node scripts/build-map-dynamics.mjs",
    "map:data:check": "node scripts/qa-map-dynamics.mjs",
    "map:data:coverage:check": "node scripts/qa-map-dynamics-coverage.mjs",
    "hosting:manifest:check": "node scripts/qa-hosting-manifest.mjs",
    "map:data:ingest": "node scripts/ingest-map-dynamics-overpass.mjs",
    "map:data:extract:pmtiles": "node scripts/extract-national-pmtiles.mjs",
    "map:data:ingest:check": "node scripts/qa-map-dynamics-ingest.mjs",
    "cctv:data:build": "node scripts/cctv-national/build.mjs --out public/data/cctv-national",
    "cctv:data:crawl": "node scripts/cctv-national/crawl.mjs",
    "cctv:data:import:opencctv": "node scripts/cctv-national/import-opencctv.mjs",
    "cctv:data:merge": "node scripts/cctv-national/merge.mjs",
    "cctv:data:probe": "node scripts/cctv-national/probe.mjs",
    "cctv:data:audit": "node scripts/cctv-national/audit.mjs",
    "cctv:data:firebase": "node scripts/cctv-national/firebase-export.mjs",
    "map:transit:check": "node scripts/qa-transit-relation-semantics.mjs",
    "map:data:promote": "node scripts/promote-map-dynamics-observations.mjs",
    "map:data:promote:check": "node scripts/qa-map-dynamics-promotion.mjs",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron electron/main.cjs",
    "desktop:open": "electron electron/main.cjs",
    "desktop:build": "npm run build && electron-builder --win nsis portable",
    "widgets:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-windows-widget-provider.ps1",
    "desktop:msix": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-msix-with-widgets.ps1",
    "desktop:portable": "npm run build && electron-builder --win portable",
    "desktop:custom-installer": "powershell -ExecutionPolicy Bypass -File scripts/build-custom-windows-installer.ps1",
    "docs:method": "node scripts/generate-method-docs.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.185.1",
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "firebase": "^12.15.0",
    "firebase-tools": "^15.18.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.2.8",
    "mapbox-gl-leaflet": "^0.0.16",
    "maplibre-gl": "^5.24.0",
    "puppeteer-core": "^24.16.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  },
  "build": {
    "appId": "id.ac.telkomuniversity.its",
    "productName": "ITS Maps",
    "copyright": "Copyright (c) 2026 Hanifa Septhi Larasati - Telkom University",
    "asar": true,
    "afterPack": "scripts/after-pack-windows.cjs",
    "appxManifestCreated": "scripts/appx-manifest-created.cjs",
    "files": [
      "electron/**/*",
      "src/icon/its.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*",
          "!artifacts",
          "!artifacts/**/*"
        ]
      },
      {
        "from": "windows-widgets/ItsMapsWidgetProvider/bin/Release/net9.0-windows10.0.22621.0/win-x64/publish",
        "to": "ItsMapsWidgetProvider",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "ITS Maps",
      "legalTrademarks": "ITS Maps - Hanifa Septhi Larasati - Telkom University",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "ITS-Maps-Windows-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ITS Maps",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "ITS Maps",
      "language": "1057",
      "installerLanguages": [
        "id_ID"
      ],
      "license": "build/windows-installer-license.txt",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "ITS-Maps-Windows-Portable-${version}-${arch}.${ext}"
    },
    "appx": {
      "identityName": "HanifaTeams.ITSMaps",
      "applicationId": "ITSMaps",
      "publisher": "CN=79B6244C-1730-4472-9953-3D2B3B9A1FB4",
      "publisherDisplayName": "Hanifa Teams",
      "displayName": "ITS Maps",
      "backgroundColor": "transparent",
      "minVersion": "10.0.22621.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": [
        "id-ID",
        "en-US"
      ],
      "capabilities": [
        "internetClient",
        "privateNetworkClientServer",
        "location",
        "runFullTrust"
      ],
      "customExtensionsPath": "build/appx-widgets-extensions.xml",
      "artifactName": "ITS-Maps-Windows-Store-${version}-${arch}.${ext}"
    },
    "extraMetadata": {
      "name": "its-maps-windows",
      "version": "1.0.51"
    }
  },
  "dependencies": {
    "katex": "^0.17.0",
    "pdfjs-dist": "4.10.38",
    "pmtiles": "^4.4.1",
    "pyodide": "^0.29.3",
    "three": "^0.185.1"
  }
}
