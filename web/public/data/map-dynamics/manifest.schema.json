{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itstelkom.web.app/data/map-dynamics/manifest.schema.json",
  "title": "ITS Maps dynamic Indonesia map manifest",
  "type": "object",
  "required": ["schemaVersion", "dataset", "datasetVersion", "generatedAt", "featureSchema", "tileZoom", "coverage", "policy", "shards"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "dataset": { "const": "its-map-dynamics-indonesia" },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "featureSchema": { "type": "string" },
    "tileZoom": { "type": "integer", "minimum": 5, "maximum": 14 },
    "coverage": {
      "type": "object",
      "required": ["country", "bbox", "mode", "actualBbox", "completedCells", "totalCells", "coveragePercent", "progressStatus", "coverageBasis"],
      "properties": {
        "country": { "const": "ID" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "mode": { "const": "incremental" },
        "actualBbox": { "oneOf": [{ "$ref": "#/$defs/bbox" }, { "type": "null" }] },
        "completedCells": { "type": ["integer", "null"], "minimum": 0 },
        "totalCells": { "type": ["integer", "null"], "minimum": 1 },
        "coveragePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "ingestedCellBbox": { "oneOf": [{ "$ref": "#/$defs/bbox" }, { "type": "null" }] },
        "progressStatus": { "enum": ["tracked", "not-linked"] },
        "coverageBasis": { "type": "string", "minLength": 1, "maxLength": 120 },
        "progressSource": { "type": ["string", "null"], "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["publish", "vision", "maxShardBytes"],
      "properties": {
        "publish": { "const": "verified-only" },
        "vision": { "const": "observation-before-verification" },
        "maxShardBytes": { "type": "integer", "minimum": 1024, "maximum": 25000000 }
      },
      "additionalProperties": false
    },
    "deltaFeed": { "type": "string", "format": "uri" },
    "shards": {
      "type": "array",
      "items": { "$ref": "#/$defs/shard" }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "shard": {
      "type": "object",
      "required": ["id", "url", "bbox", "minZoom", "maxZoom", "groups", "featureCount", "bytes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+$" },
        "url": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "minZoom": { "type": "number", "minimum": 0, "maximum": 24 },
        "maxZoom": { "type": "number", "minimum": 0, "maximum": 24 },
        "groups": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "featureCount": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
