{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "itstelkom",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk",
      "**/*.idsig",
      "artifacts/**",
      "source-atlas/**",
      "docs/**",
      "**/*.jar",
      "**/*.tar.gz",
      "data/map-dynamics/shards/**"
    ],
    "rewrites": [
      {
        "source": "/documentation",
        "destination": "/documentation/index.html"
      },
      {
        "source": "/documentation/**",
        "destination": "/documentation/index.html"
      },
      {
        "source": "/method",
        "destination": "/method/index.html"
      },
      {
        "source": "/method/android",
        "destination": "/method/android/index.html"
      },
      {
        "source": "/method/android/**",
        "destination": "/method/android/index.html"
      },
      {
        "source": "/method/windows",
        "destination": "/method/windows/index.html"
      },
      {
        "source": "/method/windows/**",
        "destination": "/method/windows/index.html"
      },
      {
        "source": "/method/webapp",
        "destination": "/method/webapp/index.html"
      },
      {
        "source": "/method/webapp/**",
        "destination": "/method/webapp/index.html"
      },
      {
        "source": "/method/**",
        "destination": "/method/index.html"
      },
      {
        "source": "/licence",
        "destination": "/licence/index.html"
      },
      {
        "source": "/licence/**",
        "destination": "/licence/index.html"
      },
      {
        "source": "/license",
        "destination": "/license/index.html"
      },
      {
        "source": "/license/**",
        "destination": "/license/index.html"
      },
      {
        "source": "/pdf-preview",
        "destination": "/pdf-preview/index.html"
      },
      {
        "source": "/pdf-preview/documentation",
        "destination": "/pdf-preview/documentation/index.html"
      },
      {
        "source": "/pdf-preview/method",
        "destination": "/pdf-preview/method/index.html"
      },
      {
        "source": "/pdf-preview/android",
        "destination": "/pdf-preview/android/index.html"
      },
      {
        "source": "/pdf-preview/windows",
        "destination": "/pdf-preview/windows/index.html"
      },
      {
        "source": "/pdf-preview/webapp",
        "destination": "/pdf-preview/webapp/index.html"
      },
      {
        "source": "/pdf-preview/licence",
        "destination": "/pdf-preview/licence/index.html"
      },
      {
        "source": "/pdf-preview/license",
        "destination": "/pdf-preview/license/index.html"
      },
      {
        "source": "/pdf-preview/fte-cd-6",
        "destination": "/pdf-preview/fte-cd-6/index.html"
      },
      {
        "source": "/pdf-preview/**",
        "destination": "/pdf-preview/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy/index.html"
      },
      {
        "source": "/privacy/**",
        "destination": "/privacy/index.html"
      },
      {
        "source": "/roadmap",
        "destination": "/roadmap/index.html"
      },
      {
        "source": "/roadmap/**",
        "destination": "/roadmap/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Origin-Trial",
            "value": "A/yLSto1peEstniGxrmY6vd5X1JtgdJcVVXDevhUBYSXYXnk536C+/SE4/y7Cdx6OYeKilNb5TfqTp35LnMWCQwAAAB4eyJvcmlnaW4iOiJodHRwczovL2l0c3RlbGtvbS53ZWIuYXBwOjQ0MyIsImZlYXR1cmUiOiJXZWJNQ1AiLCJleHBpcnkiOjE3OTQ4NzM2MDAsImlzU3ViZG9tYWluIjp0cnVlLCJpc1RoaXJkUGFydHkiOnRydWV9"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/privacy/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/documentation**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/method**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/pdf-preview",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/pdf-preview/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/licence**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/license**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/roadmap/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/presentation/**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app-update.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.b64",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.png",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.jpg",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.jpeg",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.webp",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}